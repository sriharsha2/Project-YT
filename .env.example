# Copy to .env and fill in. Never commit .env.

# Postgres container credentials (docker compose only)
POSTGRES_USER=ytauto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ytauto

# API / worker
# Host is "postgres" inside docker compose; use "localhost" when running Go directly.
DATABASE_URL=postgres://ytauto:change-me@postgres:5432/ytauto?sslmode=disable
REDIS_ADDR=redis:6379
HTTP_ADDR=:8080
# debug | info | warn | error
LOG_LEVEL=info
